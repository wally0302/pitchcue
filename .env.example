# 必填：OpenAI API key
OPENAI_API_KEY=sk-...

# 選填：模型（預設值如下，通常不用改）
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_CLEAN_MODEL=gpt-5.6-luna
# OPENAI_CHAT_MODEL=gpt-5.6-terra

# 必填：登入設定（三個缺一個就沒人能登入，避免網址外流被刷額度）
# SESSION_SECRET 用 `openssl rand -base64 32` 產生；ALLOWED_EMAILS 逗號分隔、不分大小寫
SESSION_SECRET=
LOGIN_PASSWORD=
ALLOWED_EMAILS=you@example.com

# 選填：data/ 內容大改後把這個值往上加，避免命中舊快取路由
# PROMPT_CACHE_KEY=appeal-qa-v1

# ---- 組員即時觀看（選用）----
# Upstash Redis（Vercel Marketplace：`vercel install upstash` 會自動注入 KV_REST_API_URL / KV_REST_API_TOKEN；
# 或到 Upstash console 建立後手動填 UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN）
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# 房間代碼：組員開 /view?code=<ROOM_CODE> 才能看，請設一串不好猜的字（預設 demo）
# ROOM_CODE=
